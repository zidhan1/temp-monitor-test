generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model monitoring {
  id         Int       @id @default(autoincrement())
  datetime   DateTime?
  temp1      Float?
  status1    String?
  temp2      Float?
  status2    String?
  button     String?
  mode       String?
  location   String?
  created_at DateTime  @default(now())
}